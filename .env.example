# IntesaPay API (payments Spring Boot)
INTESAPAY_BASE_URL=http://localhost:8080

# From console → Accounts → account detail (shown once on create / rotate)
INTESAPAY_ACCOUNT_ID=acct_...
INTESAPAY_API_KEY=intesapay_...
INTESAPAY_WEBHOOK_SECRET=whsec_...

# This harness listens here — point the account webhook URL at:
#   http://host.docker.internal:8001/webhooks/intesapay/
# or (same machine as payments):
#   http://127.0.0.1:8001/webhooks/intesapay/
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=1
