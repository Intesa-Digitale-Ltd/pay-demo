# IntesaPay API
INTESAPAY_BASE_URL=https://api-test.intesapay.io

# From console → Accounts → account detail (shown once on create / rotate)
INTESAPAY_ACCOUNT_ID=acct_...
INTESAPAY_API_KEY=intesapay_...
INTESAPAY_WEBHOOK_SECRET=whsec_...

# This harness listens on port 8001. The API at api-test.intesapay.io cannot
# reach 127.0.0.1, so point the account webhook at a public tunnel:
#   https://<your-tunnel>/webhooks/intesapay/
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=1
